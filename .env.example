# Copy to .env (local only — never commit real values).
# SQLite file for contact/feedback messages.
# Defaults to ./data/contact.db when unset.
CONTACT_DB_PATH=./data/contact.db

# Supabase backend (Next.js convention: NEXT_PUBLIC_* is exposed to browsers).
# Frontend must ONLY use the anon key — never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
